# ---- CVnator configuration (copy to .env) ----
CVNATOR_DATA_DIR=./data
CVNATOR_DB_URL=sqlite+pysqlite:///./data/cvnator.sqlite3

# AI providers (local-first). Ollama default.
CVNATOR_REASONING_PROVIDER=ollama
CVNATOR_REASONING_MODEL=qwen3.5:9b
CVNATOR_VISION_PROVIDER=ollama
CVNATOR_VISION_MODEL=gemma3:4b
CVNATOR_RESUME_MODEL=qwen3.5:9b
CVNATOR_TRANSLATION_MODEL=qwen3.5:9b
CVNATOR_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional remote OpenAI-compatible endpoint. Leaving key empty keeps everything local.
CVNATOR_OPENAI_BASE_URL=
CVNATOR_OPENAI_API_KEY=

# VRAM budget in MB. Resource manager swaps models to stay under this.
CVNATOR_VRAM_BUDGET_MB=11000

# Browser
CVNATOR_BROWSER_HEADLESS=false
CVNATOR_BROWSER_SLOWMO_MS=0

# Safety / autonomy defaults (overridable per-session from the UI)
CVNATOR_DRY_RUN=true
CVNATOR_AUTO_SUBMIT=false
CVNATOR_DEBUG_KEEP_SCREENSHOTS=false
